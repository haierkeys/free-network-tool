
# Minimal OpenWrt configuration for honk-core, installed as
# /etc/honk/config.dae.
#
# This file only provides a working skeleton: add your nodes or subscriptions
# and routing rules before enabling the service, and adjust the interfaces for
# the device. It intentionally routes everything directly so that enabling the
# service does not break connectivity before a proxy is configured.
#
# Interfaces: br-lan is the default OpenWrt LAN bridge; `auto` follows the
# interface of the IPv4 default route. Set lan_interface to your LAN device
# list (comma separated) if it differs.
#
# Open http://<router LAN IP>:9527/ from the LAN, for example
# http://192.168.1.1:9527/. Use the IP address: honk refuses host names such as
# openwrt.lan. The page uses plain HTTP, like LuCI; the default firewall keeps
# port 9527 closed on WAN. To keep it on the router only, listen on
# 127.0.0.1:9527 and reach it with ssh -L 9527:127.0.0.1:9527 root@<router>.
#
# The first visit creates the administrator. Sign in to edit configuration.
# For a reverse proxy, terminate TLS there; for token authentication, replace
# password_auth with secret.

global {
    wan_interface: auto
    lan_interface: br-lan
    log_level: info
    dial_mode: domain++
    tls_implementation: utls
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk/data'
    # Empty: log to stdout, which procd forwards to syslog/logread.
    log_file: ''
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    check_interval: 30s
    check_tolerance: 50ms
    bootstrap_resolver: '223.5.5.5:53'
    # Hold ambiguous LAN UDP first packets through NFQUEUE. Requires the
    # nfnetlink_queue and nft_queue kernel modules, which the package depends on.
    nfqueue_enable: true
}


dns {
    upstream {
        # dnsmasq on the router; honk sends its own DNS lookups there.
        remote: 'https://8.8.8.8/dns-query'
        local: 'https://223.5.5.5/dns-query'
    }
    routing {
        request {
            qtype(https, svcb) -> reject
            qtype(aaaa) -> reject
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn, geosite: private) -> local
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # remote 解析出国内 IP 时改用 local 重查，拿到就近 CDN
            upstream(remote) && ip(geoip: cn) -> local
            fallback: accept
        }
    }
}


routing {

    # dnsmasq is the local DNS upstream. Its own queries leave through the WAN
    # hook; without this rule honk would intercept them and send them back to
    # dnsmasq, a loop that times out every lookup.
   # pname(dnsmasq) -> direct(must)

    # Start with everything direct; add proxy groups and rules above this
    # fallback once nodes are configured.
    #fallback: direct
    # 如果 DNS 为内网IP 需要添加此条 对dns流量进行放行
    # dip(192.168.16.3) -> direct(must)
    dip(223.5.5.5) -> direct(must)

    dip(geoip: private, geoip: cn) && !dport(53, 853) -> direct(must)
    dport(853) -> block
    l4proto(udp) && dport(443) -> block
    domain(suffix: cnb.cool) -> direct
    domain(suffix: diybeta.com) -> direct
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Google
    domain(suffix: withgoogle.com, suffix: notebooklm.google, geosite: category-ai-!cn) -> AI
    domain(geosite: youtube) -> YouTube
    domain(geosite: google) -> Google
    domain(geosite: github) -> Github
    domain(geosite: onedrive) -> OneDrive
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> Microsoft
    domain(geosite: apple@cn) -> direct
    domain(geosite: apple) -> Apple
    domain(geosite: telegram) -> Telegram
    domain(geosite: tiktok) -> TikTok
    domain(geosite: netflix) -> Netflix
    domain(geosite: paypal, geosite: binance, geosite: okx, geosite: category-cryptocurrency) -> Wallet
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Steam
    domain(geosite: geolocation-!cn) -> Proxy
    dip(geoip: telegram) -> Telegram
    fallback: Final
}


group {
    Status {
        filter: name(regex: '剩余|到期|重置')
        policy: selector
        final: direct
    }

    Manual {
        filter:  !name(regex: '剩余|到期|重置')
        policy: selector
        interrupt_connections: true
        final: Final
    }

    # ==================== 1. 香港 (HK) 组 ====================
    HK_Manual {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '剩余|到期|重置')
        policy: selector
        interrupt_connections: true
        final: Final
    }
    HK_Auto {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '剩余|到期|重置')
        policy: urltest
        tolerance: 50
        idle_timeout: 1800
        interrupt_connections: true
        final: Final
    }
    HK_LoadBalance {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '剩余|到期|重置')
        policy: loadbalance
        interrupt_connections: true
        final: Final
    }
    HK_Score {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '剩余|到期|重置')
        policy: score
        interrupt_connections: true
        final: Final
    }

    # ==================== 2. 日本 (JP) 组 ====================
    JP_Manual {
        filter: name(regex: '🇯🇵|JP|jp|日本|东京|大阪') && !name(regex: '剩余|到期|重置')
        policy: selector
        interrupt_connections: true
        final: Final
    }
    JP_Auto {
        filter: name(regex: '🇯🇵|JP|jp|日本|东京|大阪') && !name(regex: '剩余|到期|重置')
        policy: urltest
        tolerance: 50
        idle_timeout: 1800
        interrupt_connections: true
        final: Final
    }
    JP_LoadBalance {
        filter: name(regex: '🇯🇵|JP|jp|日本|东京|大阪') && !name(regex: '剩余|到期|重置')
        policy: loadbalance
        interrupt_connections: true
        final: Final
    }
    JP_Score {
        filter: name(regex: '🇯🇵|JP|jp|日本|东京|大阪') && !name(regex: '剩余|到期|重置')
        policy: score
        interrupt_connections: true
        final: Final
    }

    # ==================== 3. 新加坡台湾 (ST) 组 ====================
    ST_Manual {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|tw|TW|台湾') && !name(regex: '剩余|到期|重置')
        policy: selector
        interrupt_connections: true
        final: Final
    }
    ST_Auto {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|tw|TW|台湾') && !name(regex: '剩余|到期|重置')
        policy: urltest
        tolerance: 50
        idle_timeout: 1800
        interrupt_connections: true
        final: Final
    }
    ST_LoadBalance {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|tw|TW|台湾') && !name(regex: '剩余|到期|重置')
        policy: loadbalance
        interrupt_connections: true
        final: Final
    }
    ST_Score {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|tw|TW|台湾') && !name(regex: '剩余|到期|重置')
        policy: score
        interrupt_connections: true
        final: Final
    }


    # ==================== 4. 美国 (US) 组 ====================
    US_Manual {
        filter: name(regex: '🇺🇸|US|us|美国|美') && !name(regex: '剩余|到期|重置')
        policy: selector
        interrupt_connections: true
        final: Final
    }
    US_Auto {
        filter: name(regex: '🇺🇸|US|us|美国|美') && !name(regex: '剩余|到期|重置')
        policy: urltest
        tolerance: 50
        idle_timeout: 1800
        interrupt_connections: true
        final: Final
    }
    US_LoadBalance {
        filter: name(regex: '🇺🇸|US|us|美国|美') && !name(regex: '剩余|到期|重置')
        policy: loadbalance
        interrupt_connections: true
        final: Final
    }
    US_Score {
        filter: name(regex: '🇺🇸|US|us|美国|美') && !name(regex: '剩余|到期|重置')
        policy: score
        interrupt_connections: true
        final: Final
    }


    # ==================== 4. 流量倍数组 ====================
    X1_Manual {
        filter: !name(regex: 'x2|剩余|到期|重置')
        policy: selector
        interrupt_connections: true
        final: Final
    }
    X1_Auto {
        filter: !name(regex: 'x2|剩余|到期|重置')
        policy: urltest
        tolerance: 50
        idle_timeout: 1800
        interrupt_connections: true
        final: Final
    }
    X1_LoadBalance {
        filter: !name(regex: 'x2|剩余|到期|重置')
        policy: loadbalance
        interrupt_connections: true
        final: Final
    }
    X1_Score {
        filter: !name(regex: 'x2|剩余|到期|重置')
        policy: score
        interrupt_connections: true
        final: Final
    }

    X2_Manual {
        filter: name(regex: '×2') && name(regex: '倍率') && !name(regex: '剩余|到期|重置')
        policy: selector
        interrupt_connections: true
        final: Final
    }
    X2_Auto {
        filter: name(regex: '×2') && name(regex: '倍率') && !name(regex: '剩余|到期|重置')
        policy: urltest
        tolerance: 50
        idle_timeout: 1800
        interrupt_connections: true
        final: Final
    }
    X2_LoadBalance {
        filter: name(regex: '×2') && name(regex: '倍率') && !name(regex: '剩余|到期|重置')
        policy: loadbalance
        interrupt_connections: true
        final: Final
    }
    X2_Score {
        filter: name(regex: '×2') && name(regex: '倍率') && !name(regex: '剩余|到期|重置')
        policy: score
        interrupt_connections: true
        final: Final
    }



    # ==================== 5. 顶层主代理组 (Proxy) ====================
    Proxy {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    Final {
        filter: !name(regex: '官网|剩余|流量|套餐|免费|订阅|到期时间|直连|Expire Date|Traffic|ExpireDate')
        policy: score
    }

    # ==================== 6. 目表站点代理组 (Proxy) ====================

    AI {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    YouTube {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    Google {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    Github {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    Telegram {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    TikTok {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: US_Manual
        final: Final
        interrupt_connections: true
    }
    Netflix {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: US_Manual
        final: Final
        interrupt_connections: true
    }
    Wallet {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    Steam {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    Microsoft {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    OneDrive {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }
    Apple {
        filter: group( Manual, HK_Auto, HK_Manual, HK_LoadBalance, HK_Score, JP_Auto, JP_Manual, JP_LoadBalance, JP_Score, ST_Auto, ST_Manual, ST_LoadBalance, ST_Score, US_Auto, US_Manual, US_LoadBalance, US_Score, X1_Auto, X1_Manual, X1_LoadBalance, X1_Score, X2_Auto, X2_Manual, X2_LoadBalance, X2_Score)
        policy: select
        default: Manual
        final: Final
        interrupt_connections: true
    }

}
## 订阅
subscription {
    sub_store: '订阅地址'
}
assets {
    route: direct
    subscription {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
    }
    geodata {
        geosite: 'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat'
        geoip: 'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat'
        route: direct
    }
}

experimental {
    # Clash-compatible API (optional; served on loopback only). The embedded
    # doona UI uses the native API below.
    clash_api {
        external_controller: '127.0.0.1:9090'
        default_mode: 'Rule'
    }
    native_api {
        enabled: true
        listen: '0.0.0.0:9091'
        password_auth: true
        config_write: true
        ui: 'embedded'
        # ui: 'embedded-lite'   # doona lite, honk v0.1.0-beta.4 and later
    }
    cache_file {
        enabled: true
    }
}